{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mermaid-mcp-admission",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Budget"] }
  ],
  "vars": {
    "MISS_PER_MINUTE": "600",
    "MISS_PER_DAY": "50000"
  }
}
